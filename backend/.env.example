PORT=4000
DATABASE_URL=postgres://gemma_edstellar_app:gemma_edstellar_dev_pw@localhost:5432/gemma_edstellar
FRONTEND_URL=http://localhost:5173

# Google AI Studio (aistudio.google.com) — free tier. Used to grade the
# open-ended speech/writing item types (Read Aloud, Story Retelling,
# Speaking Situations, Summary & Opinion, Email Writing, Open Questions,
# Passage Reconstruction). Without it, those types stay "pending" forever,
# same as before this was added.
GEMINI_API_KEY=your-gemini-api-key

# Google Workspace / Gmail SMTP — use an App Password, not your regular login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@yourdomain.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-address@yourdomain.com
